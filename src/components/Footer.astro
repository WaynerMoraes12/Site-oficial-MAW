---
import logo from '../assets/brand/maw-logo-web.png';
import site from '../data/site.json';
import { fill, type Dictionary } from '../i18n';

interface Props {
  t: Dictionary;
}
const { t } = Astro.props;
---
<footer>
  <div class="wrap">
    <div class="top" translate="no">
      <img data-logo src={logo.src} width={logo.width} height={logo.height} alt="MAW" />
      <span>MAW — {site.fullName} · v{site.version}</span>
    </div>
    <!-- o nome por trás da sigla MAW e, assinada à mão, a homenagem ao pai do autor -->
    <div class="sign" translate="no">
      <span class="sign-name"><b>M</b>ORAES <b>A</b>UDIO <b>W</b>ORKSTATION</span>
      <span class="sign-memory">Memory All Wagner</span>
      <svg class="sign-swash" viewBox="0 0 400 36" aria-hidden="true">
        <defs>
          <linearGradient id="swash-ink" x1="0" x2="1">
            <stop offset="0" stop-color="#f3eefc" stop-opacity="0" />
            <stop offset=".25" stop-color="#f3eefc" />
            <stop offset="1" stop-color="#b84dff" stop-opacity=".2" />
          </linearGradient>
        </defs>
        <path pathLength="1" d="M8 22 C 70 30, 140 8, 210 16 S 330 30, 392 9" />
      </svg>
    </div>
    <p class="legal">{fill(t.footer.legal, { year: site.year, author: site.author })}</p>
  </div>
</footer>
