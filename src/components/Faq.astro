---
import { faq } from '../data/faq';
---
<section class="sec faq" id="faq">
  <div class="wrap faq-grid">
    <div>
      <div class="eyebrow">FAQ</div>
      <h2 class="h-goth md">Questions from the crowd</h2>
    </div>
    <div>
      {faq.map((f, i) => (
        <details open={i === 0}>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
