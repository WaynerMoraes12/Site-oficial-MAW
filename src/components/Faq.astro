---
import type { Dictionary } from '../i18n';

interface Props {
  t: Dictionary;
}
const { t } = Astro.props;
---
<section class="sec faq" id="faq">
  <div class="wrap faq-grid">
    <div>
      <div class="eyebrow">{t.faq.eyebrow}</div>
      <h2 class="h-goth md">{t.faq.title}</h2>
    </div>
    <div>
      {t.faq.items.map((f, i) => (
        <details open={i === 0}>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
