---
import logo from '../assets/brand/maw-logo-web.png';
import site from '../data/site.json';
import type { Dictionary } from '../i18n';

interface Props {
  t: Dictionary;
}
const { t } = Astro.props;
const h = t.hero;
---
<header class="hero" id="top">
  <div class="wrap hero-grid">
    <div>
      <div class="catalog" translate="no"><span><b>MAW-001</b></span><span>WIN · MAC · LINUX</span><span>v{site.version}</span><span>℗ {site.year}</span></div>
      <h1>
        <span class="chrome">{h.title1}</span>
        <span class="l2 chrome">{h.title2a} <span class="bolt" aria-hidden="true"></span> {h.title2b}</span>
      </h1>
      <p class="lede">{h.ledeBefore}<b translate="no">Musical Artificial Workspace</b>{h.ledeAfter}</p>
      <div class="ctas">
        <a class="btn btn-rec" href="#download">{h.ctaDownload}</a>
        <a class="btn btn-ghost" href="#stage">{h.ctaStage}</a>
      </div>
      <div class="meta">{h.meta}</div>
    </div>
    <div class="record" aria-hidden="true" translate="no">
      <div class="vinyl"><div class="label"><img data-logo src={logo.src} width={logo.width} height={logo.height} alt="" /></div></div>
      <div class="sleeve">
        <img data-logo src={logo.src} width={logo.width} height={logo.height} alt="" />
        <div class="spine"><span>MUSICAL</span><span>ARTIFICIAL</span><span>WORKSPACE</span></div>
      </div>
      <div class="advisory"><div class="t">{h.advisory[0]}</div><div class="b">{h.advisory[1]}</div><div class="s">{h.advisory[2]}</div></div>
    </div>
  </div>
</header>
