---
import '@fontsource/anton/latin-400.css';
import '@fontsource/grenze-gotisch/latin-400.css';
import '@fontsource/grenze-gotisch/latin-900.css';
import '@fontsource/syncopate/latin-400.css';
import '@fontsource/syncopate/latin-700.css';
import '@fontsource/barlow/latin-400.css';
import '@fontsource/barlow/latin-600.css';
import '@fontsource/barlow/latin-700.css';
import '@fontsource/barlow-condensed/latin-600.css';
import '@fontsource/barlow-condensed/latin-700.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-600.css';
import '@fontsource/share-tech-mono/latin-400.css';
import '@fontsource/big-shoulders-stencil-display/latin-900'; // exports antigo: sem .css
import '../styles/global.css';
import antonLatin from '@fontsource/anton/files/anton-latin-400-normal.woff2?url';
import barlowLatin from '@fontsource/barlow/files/barlow-latin-400-normal.woff2?url';
import barlowBold from '@fontsource/barlow/files/barlow-latin-700-normal.woff2?url';
import { withBase } from '../lib/url';
import { dictionaries, localeUrl, locales, pickLocale, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = dictionaries[locale];
const ogImage = new URL(withBase('og-image.png'), Astro.site).href;
const alternates = locales.map((l) => ({ lang: dictionaries[l].meta.htmlLang, href: new URL(localeUrl(l), Astro.site).href }));
const ogAlternates = locales.filter((l) => l !== locale).map((l) => dictionaries[l].meta.ogLocale);

// Link interno: liga html.cv-off (seções com tamanho real) e rola na hora; ao fim da rolagem realinha,
// e quando as fontes dessas seções terminarem de carregar realinha de novo se a pessoa ainda estiver
// perto do alvo. Sem isso o content-visibility e a troca de fonte tiram a rolagem do alvo.
const anchorFix = `(function(){var d=document.documentElement;var off=function(){d.classList.add('cv-off');void d.offsetHeight;};var gap=function(el){return el.getBoundingClientRect().top-(parseFloat(getComputedStyle(el).scrollMarginTop)||0);};var fix=function(el,near){var g=gap(el);if(Math.abs(g)>4&&(!near||Math.abs(g)<300))el.scrollIntoView({behavior:'instant',block:'start'});};var go=function(el,how){el.scrollIntoView({behavior:how,block:'start'});var after=function(){fix(el,false);if(document.fonts&&document.fonts.status!=='loaded'){document.fonts.ready.then(function(){requestAnimationFrame(function(){fix(el,true);});});}};if(how==='smooth'&&'onscrollend' in window){window.addEventListener('scrollend',after,{once:true});}else{requestAnimationFrame(after);}};var smooth=function(){return window.matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth';};if(location.hash){window.addEventListener('load',function(){var el=document.getElementById(decodeURIComponent(location.hash.slice(1)));if(el){off();go(el,'instant');}});}document.addEventListener('click',function(e){if(e.defaultPrevented||e.button!==0||e.metaKey||e.ctrlKey||e.shiftKey||e.altKey)return;var a=e.target&&e.target.closest?e.target.closest('a[href^="#"]'):null;if(!a)return;var el=document.getElementById(a.getAttribute('href').slice(1));if(!el)return;e.preventDefault();off();go(el,smooth());history.pushState(null,'','#'+el.id);});})();`;

// Só na raiz em inglês: quem ainda não escolheu língua abre na do navegador (pt → /pt/, es → /es/).
const autoLanguage = `try{if(!localStorage.getItem('maw-lang')){var l=(${pickLocale.toString()})(navigator.languages&&navigator.languages.length?navigator.languages:[navigator.language]);var u=${JSON.stringify({ pt: localeUrl('pt'), es: localeUrl('es') })};if(u[l])location.replace(u[l]);}}catch(e){}`;
---
<!doctype html>
<html lang={t.meta.htmlLang}>
  <head>
    <meta charset="utf-8" />
    {locale === 'en' && <script is:inline set:html={autoLanguage} />}
    <script is:inline set:html={anchorFix} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <meta name="theme-color" content="#000000" />
    <link rel="preload" as="font" type="font/woff2" href={antonLatin} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={barlowLatin} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={barlowBold} crossorigin />
    <link rel="icon" type="image/png" href={withBase('favicon.png')} />
    <link rel="apple-touch-icon" href={withBase('apple-touch-icon.png')} />
    <link rel="sitemap" href={withBase('sitemap-index.xml')} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(localeUrl('en'), Astro.site).href} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:locale" content={t.meta.ogLocale} />
    {ogAlternates.map((o) => <meta property="og:locale:alternate" content={o} />)}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <slot />
  </body>
</html>
